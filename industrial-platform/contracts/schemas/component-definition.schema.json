{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.industrial-platform.local/schemas/v1/component-definition.schema.json",
  "title": "Component definition (one version)",
  "description": "Schema-driven, versioned definition of a reusable graphic component. It contains NO executable code: rendering is done by a platform renderer chosen from a whitelist (rendererId); everything else is declarative configuration. One JSON = one immutable version (component_versions.spec) once published.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid", "description": "Stable definition id shared by all versions." },
    "key": { "$ref": "common.schema.json#/$defs/qualifiedKey" },
    "schemaVersion": { "const": 1 },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "category": { "enum": ["kpi", "chart", "gauge", "table", "status", "symbol", "layout", "text", "control"] },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "description": { "$ref": "common.schema.json#/$defs/localizedText" },
    "status": { "$ref": "common.schema.json#/$defs/publishStatus" },
    "rendererId": {
      "description": "Built-in renderer from the frontend element registry, '<namespace>.<name>@<major>'. Unknown renderer ids are rejected at save time.",
      "type": "string",
      "pattern": "^builtin\\.[a-z][a-z0-9-]*@[1-9][0-9]*$"
    },
    "properties": {
      "description": "Configurable props shown in the property inspector.",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/propertySpec" }
    },
    "defaults": {
      "description": "Default prop values, keyed by property key. Must validate against the property specs (semantic check).",
      "type": "object"
    },
    "inputs": {
      "description": "Data ports a binding can feed (e.g. 'value', 'series').",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/portSpec" }
    },
    "outputs": {
      "description": "Events the component can emit. v1 only supports declarative actions handled by the runtime (navigate, open-object-detail).",
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "key": { "$ref": "common.schema.json#/$defs/key" },
          "label": { "$ref": "common.schema.json#/$defs/localizedText" },
          "allowedActions": { "type": "array", "items": { "enum": ["navigate", "open_object_detail"] }, "uniqueItems": true }
        },
        "required": ["key", "allowedActions"],
        "additionalProperties": false
      }
    },
    "bindings": {
      "description": "Which binding source kinds may feed which input.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": { "$ref": "common.schema.json#/$defs/key" },
          "allowedSources": {
            "type": "array",
            "items": { "enum": ["object_variable", "model_output", "data_source_signal", "static"] },
            "minItems": 1, "uniqueItems": true
          },
          "requiredQuantity": { "type": "string", "description": "Optional physical quantity (power, energy, ratio, temperature...) the bound value must have." }
        },
        "required": ["input", "allowedSources"],
        "additionalProperties": false
      }
    },
    "style": {
      "description": "Styleable parts and the theme tokens the component consumes.",
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "part": { "$ref": "common.schema.json#/$defs/key" },
              "allowed": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            },
            "required": ["part", "allowed"],
            "additionalProperties": false
          }
        },
        "tokens": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "defaults": { "$ref": "common.schema.json#/$defs/styleBlock" }
      },
      "additionalProperties": false
    },
    "validationRules": {
      "description": "Cross-property rules written in the safe expression grammar over prop keys; evaluated in editor and server.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/key" },
          "assert": { "$ref": "common.schema.json#/$defs/expression" },
          "message": { "$ref": "common.schema.json#/$defs/localizedText" },
          "severity": { "enum": ["error", "warning"] }
        },
        "required": ["id", "assert", "message"],
        "additionalProperties": false
      }
    },
    "layoutConstraints": {
      "type": "object",
      "properties": {
        "minWidth": { "type": "integer", "minimum": 0 },
        "minHeight": { "type": "integer", "minimum": 0 },
        "maxWidth": { "type": "integer", "minimum": 1 },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "resizable": { "type": "boolean" },
        "allowedParents": { "type": "array", "items": { "enum": ["section", "container", "stack", "grid", "column"] }, "uniqueItems": true },
        "allowedDocumentTypes": { "type": "array", "items": { "enum": ["page", "template", "template_part", "dashboard"] }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "use": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/permissionKey" } },
        "edit": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/permissionKey" } }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "minPlatformVersion": { "$ref": "common.schema.json#/$defs/semver" },
        "upgradeFrom": {
          "description": "Declarative migration of instance props from an older version range (rename/remove/default). No code.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "range": { "$ref": "common.schema.json#/$defs/semverRange" },
              "rename": { "type": "object", "additionalProperties": { "type": "string" } },
              "remove": { "type": "array", "items": { "type": "string" } },
              "set": { "type": "object" }
            },
            "required": ["range"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "changelog": { "type": "string", "maxLength": 4000 }
  },
  "required": ["id", "key", "schemaVersion", "version", "category", "name", "status", "rendererId", "properties", "defaults", "inputs"],
  "additionalProperties": false,
  "$defs": {
    "propertySpec": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,62}$" },
        "label": { "$ref": "common.schema.json#/$defs/localizedText" },
        "type": { "enum": ["string", "text", "number", "integer", "boolean", "enum", "color", "token", "unit", "icon", "media", "objectRef"] },
        "required": { "type": "boolean" },
        "enum": { "type": "array", "items": { "type": ["string", "number"] }, "minItems": 1, "uniqueItems": true },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "bindable": { "type": "boolean", "description": "Prop can be fed by a binding instead of a literal." },
        "group": { "type": "string", "maxLength": 40 },
        "help": { "$ref": "common.schema.json#/$defs/localizedText" }
      },
      "required": ["key", "label", "type"],
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["enum"] } }
      ]
    },
    "portSpec": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,62}$" },
        "label": { "$ref": "common.schema.json#/$defs/localizedText" },
        "dataType": { "enum": ["number", "integer", "boolean", "string", "enum", "timestamp", "timeseries", "table"] },
        "unit": { "$ref": "common.schema.json#/$defs/unit" },
        "quantity": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "required": ["key", "dataType"],
      "additionalProperties": false
    }
  }
}
