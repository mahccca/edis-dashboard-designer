{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.industrial-platform.local/schemas/v1/theme.schema.json",
  "title": "Theme (design tokens, one version)",
  "description": "Design tokens grouped by category. Emitted by the style engine as CSS custom properties (--color-surface-raised ...). Token values are literals or aliases to other tokens; no raw CSS.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "schemaVersion": { "const": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "mode": { "enum": ["light", "dark"] },
    "tokens": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/group" },
        "space": { "$ref": "#/$defs/group" },
        "radius": { "$ref": "#/$defs/group" },
        "font": { "$ref": "#/$defs/group" },
        "shadow": { "$ref": "#/$defs/group" },
        "status": { "$ref": "#/$defs/group" }
      },
      "required": ["color", "space", "font"],
      "additionalProperties": false
    },
    "breakpoints": {
      "type": "object",
      "properties": {
        "tablet": { "type": "integer", "minimum": 320, "maximum": 2560 },
        "mobile": { "type": "integer", "minimum": 240, "maximum": 1280 }
      },
      "required": ["tablet", "mobile"],
      "additionalProperties": false
    }
  },
  "required": ["id", "schemaVersion", "version", "name", "tokens", "breakpoints"],
  "additionalProperties": false,
  "$defs": {
    "group": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9-]{1,40}$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/group" },
          { "$ref": "common.schema.json#/$defs/tokenRef" },
          { "type": "number" },
          { "type": "string", "maxLength": 120, "pattern": "^[^;{}<>\\\\]*$" }
        ]
      }
    }
  }
}
