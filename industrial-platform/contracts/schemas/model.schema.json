{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.industrial-platform.local/schemas/v1/model.schema.json",
  "title": "Computational model (one version)",
  "description": "Generic, domain-agnostic model contract: typed inputs, parameters, intermediate variables and outputs, each with units; formulas in the safe expression grammar. The server parses formulas into an AST (expression.schema.json), builds the dependency DAG (cycles rejected), checks that every identifier is declared, and only then allows publishing. Runs are executed asynchronously by the worker with a hard timeout.",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/uuid" },
    "key": { "$ref": "common.schema.json#/$defs/qualifiedKey" },
    "schemaVersion": { "const": 1 },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "status": { "$ref": "common.schema.json#/$defs/publishStatus" },
    "name": { "$ref": "common.schema.json#/$defs/localizedText" },
    "description": { "$ref": "common.schema.json#/$defs/localizedText" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/quantitySpec" },
          {
            "properties": {
              "required": { "type": "boolean" },
              "defaultSource": { "$ref": "#/$defs/inputSource" }
            }
          }
        ]
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/quantitySpec" },
          { "properties": { "default": { "type": "number" } }, "required": ["default"] }
        ]
      }
    },
    "variables": {
      "description": "Intermediate computed values.",
      "type": "array",
      "maxItems": 128,
      "items": { "allOf": [{ "$ref": "#/$defs/quantitySpec" }, { "required": ["formula"] }] }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "allOf": [{ "$ref": "#/$defs/quantitySpec" }, { "required": ["formula"] }] }
    },
    "validation": {
      "description": "Pre-conditions on inputs/parameters. A failing 'error' rule fails the run with a clear message instead of producing a misleading number.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/key" },
          "assert": { "$ref": "common.schema.json#/$defs/expression" },
          "message": { "$ref": "common.schema.json#/$defs/localizedText" },
          "severity": { "enum": ["error", "warning"] }
        },
        "required": ["id", "assert", "message", "severity"],
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "maxEvaluationSteps": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "triggers": {
          "description": "v1 implements 'manual' only; 'schedule' and 'event' are reserved in the contract.",
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "object", "properties": { "kind": { "const": "manual" } }, "required": ["kind"], "additionalProperties": false },
              { "type": "object", "properties": { "kind": { "const": "schedule" }, "cron": { "type": "string", "pattern": "^[0-9*/,-]+( [0-9*/,-]+){4}$" } }, "required": ["kind", "cron"], "additionalProperties": false },
              { "type": "object", "properties": { "kind": { "const": "event" }, "event": { "enum": ["input_changed", "object_alarm"] } }, "required": ["kind", "event"], "additionalProperties": false }
            ]
          }
        }
      },
      "required": ["timeoutMs", "triggers"],
      "additionalProperties": false
    }
  },
  "required": ["id", "key", "schemaVersion", "version", "status", "name", "inputs", "outputs", "execution"],
  "additionalProperties": false,
  "$defs": {
    "formula": {
      "type": "object",
      "properties": {
        "expression": { "$ref": "common.schema.json#/$defs/expression" },
        "ast": { "$ref": "expression.schema.json", "description": "Server-generated, read-only." }
      },
      "required": ["expression"],
      "additionalProperties": false
    },
    "quantitySpec": {
      "type": "object",
      "properties": {
        "key": { "$ref": "common.schema.json#/$defs/key" },
        "name": { "$ref": "common.schema.json#/$defs/localizedText" },
        "unit": { "$ref": "common.schema.json#/$defs/unit" },
        "quantity": { "type": "string" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "formula": { "$ref": "#/$defs/formula" },
        "required": true,
        "default": true,
        "defaultSource": true
      },
      "required": ["key", "name", "unit"],
      "additionalProperties": false
    },
    "inputSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "object_variable" },
            "objectId": { "$ref": "common.schema.json#/$defs/uuid" },
            "variable": { "$ref": "common.schema.json#/$defs/key" },
            "aggregation": { "enum": ["last", "avg", "sum", "max", "min"] },
            "window": { "enum": ["now", "today", "last_1h", "last_24h", "yesterday"] }
          },
          "required": ["kind", "objectId", "variable", "aggregation", "window"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": { "kind": { "const": "run_argument" } },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    }
  }
}
