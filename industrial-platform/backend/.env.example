# Copy to backend/.env (git-ignored) or export as environment variables. Placeholders only.

# Required. SQLAlchemy URL (psycopg driver). URL-encode special characters in the password.
IP_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:55432/ip_dev

# Session cookie "Secure" flag. Must be true behind HTTPS; false only for http://localhost dev.
IP_COOKIE_SECURE=false
IP_SESSION_TTL_HOURS=12
IP_SESSION_IDLE_MINUTES=120

# JSON list. Empty list = Origin not checked (dev only). Production MUST list the studio/runtime origins.
IP_ALLOWED_ORIGINS=["http://localhost:5180"]

# Real SCADA adapter (scada_http_ws) is NOT implemented. Keep false; true only unlocks creating
# such data sources, and every call still returns 501 adapter_not_implemented.
IP_FEATURE_SCADA_ADAPTER=false

IP_MAX_DOCUMENT_BYTES=2097152
IP_WS_PUSH_INTERVAL_SECONDS=1.0

# Tests only: a role that may CREATE DATABASE. Each run creates, migrates and drops ip_test_<random>.
# IP_TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:55432/postgres

# CLI create-user reads password from here (or prompt). Do not store it in this file.
# IP_NEW_USER_PASSWORD=
